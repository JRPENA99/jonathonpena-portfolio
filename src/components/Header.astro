---
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="mark" aria-label="Jonathon Pena, home">
      <span class="mark-box" aria-hidden="true">JP</span>
      <span class="mark-name">Jonathon Pena</span>
    </a>

    <nav aria-label="Primary" class="nav" id="site-nav">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <div class="nav-extra">
        <a href={site.github} class="icon-link" aria-label="GitHub" rel="me noopener" target="_blank">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
          <span class="icon-label">GitHub</span>
        </a>
        <a href={site.linkedin} class="icon-link" aria-label="LinkedIn" rel="me noopener" target="_blank">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
          <span class="icon-label">LinkedIn</span>
        </a>
        <a href="/contact/" class="btn btn-primary contact-btn" aria-current={isActive('/contact/') ? 'page' : undefined}>Contact</a>
      </div>
    </nav>

    <div class="actions">
      <button class="theme-toggle" type="button" aria-label="Toggle light and dark theme" data-theme-toggle>
        <svg class="i-sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
      </button>
      <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" data-menu-toggle>
        <span class="sr-only">Menu</span>
        <span class="bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; gap: 20px; height: 64px; }

  .mark { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text); font-weight: 600; letter-spacing: -0.01em; }
  .mark-box {
    display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px;
    border: 1px solid var(--border-strong); font: 600 0.72rem/1 var(--font-mono); letter-spacing: 0.02em;
    background: var(--surface);
  }

  .nav { display: flex; align-items: center; gap: 18px; margin-left: auto; }
  .nav ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav ul a {
    display: block; padding: 7px 11px; border-radius: 8px; font-size: 0.92rem; color: var(--text-2);
    text-decoration: none; transition: color 0.15s, background 0.15s;
  }
  .nav ul a:hover { color: var(--text); background: var(--surface-2); }
  .nav ul a[aria-current='page'] { color: var(--text); background: var(--surface-2); }

  .nav-extra { display: flex; align-items: center; gap: 6px; }
  .icon-link { text-decoration: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 8px; color: var(--text-2); }
  .icon-link:hover { color: var(--text); background: var(--surface-2); }
  .icon-label { display: none; }
  .contact-btn { padding: 9px 14px; font-size: 0.88rem; margin-left: 4px; }

  .actions { display: flex; align-items: center; gap: 4px; }
  .theme-toggle, .menu-toggle {
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: 8px;
    border: 1px solid transparent; background: transparent; color: var(--text-2); cursor: pointer;
  }
  .theme-toggle:hover, .menu-toggle:hover { color: var(--text); background: var(--surface-2); }
  :global([data-theme='dark']) .i-sun { display: none; }
  :global([data-theme='light']) .i-moon { display: none; }

  .menu-toggle { display: none; }
  .bars { display: grid; gap: 5px; width: 18px; }
  .bars span { height: 1.6px; background: currentColor; border-radius: 2px; transition: transform 0.25s var(--ease); }
  .menu-toggle[aria-expanded='true'] .bars span:first-child { transform: translateY(3.3px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .bars span:last-child { transform: translateY(-3.3px) rotate(-45deg); }

  @media (max-width: 900px) {
    .mark-name { display: none; }
    .actions { margin-left: auto; }
    .menu-toggle { display: grid; }
    .nav {
      position: fixed; inset: 64px 0 auto 0; margin: 0;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--bg); border-bottom: 1px solid var(--border);
      padding: 8px var(--gutter) 20px;
      max-height: calc(100dvh - 64px); overflow-y: auto;
      visibility: hidden; opacity: 0; transform: translateY(-8px);
      transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0s linear 0.2s;
    }
    :global(.menu-open) .nav { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
    .nav ul { flex-direction: column; }
    .nav ul a { padding: 14px 4px; font-size: 1.1rem; border-radius: 0; border-bottom: 1px solid var(--border); }
    .nav ul a:hover, .nav ul a[aria-current='page'] { background: none; }
    .nav ul a[aria-current='page'] { color: var(--accent); }
    .nav-extra { padding-top: 16px; gap: 8px; flex-wrap: wrap; }
    .icon-link { width: auto; padding: 0 12px; gap: 8px; display: inline-flex; align-items: center; border: 1px solid var(--border); height: 44px; }
    .icon-label { display: inline; font-size: 0.92rem; }
    .contact-btn { margin-left: auto; height: 44px; }
  }
</style>
