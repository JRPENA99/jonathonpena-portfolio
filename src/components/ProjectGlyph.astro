---
/**
 * Schematic cover art for projects without a screenshot yet.
 * Each is a stylized sketch of the project's interface or pipeline, not a screenshot.
 * Unknown ids fall back to a generic grid.
 */
interface Props { id: string }
const { id } = Astro.props;
---

<svg viewBox="0 0 640 360" role="img" aria-label="Schematic illustration" class="glyph" preserveAspectRatio="xMidYMid slice">
  <defs>
    <pattern id={`g-${id}`} width="24" height="24" patternUnits="userSpaceOnUse">
      <path d="M24 0H0v24" fill="none" stroke="var(--border)" stroke-width="1" />
    </pattern>
  </defs>
  <rect width="640" height="360" fill="var(--bg-sunk)" />
  <rect width="640" height="360" fill={`url(#g-${id})`} opacity="0.7" />

  {id === 'content-engine' && (
    <g font-family="var(--font-mono)" font-size="12" fill="var(--text-2)">
      {[['visuals', 70], ['audio', 160], ['config', 250]].map(([l, y]) => (
        <g>
          <rect x="48" y={Number(y) - 22} width="132" height="44" rx="8" fill="var(--surface)" stroke="var(--border-strong)" />
          <text x="66" y={Number(y) + 4}>{l}</text>
          <path d={`M180 ${y} C 230 ${y}, 230 180, 268 180`} fill="none" stroke="var(--st-building)" stroke-opacity="0.6" stroke-width="1.5" />
        </g>
      ))}
      <rect x="268" y="150" width="120" height="60" rx="10" fill="var(--surface)" stroke="var(--st-building)" />
      <text x="288" y="185" fill="var(--text)">python</text>
      <path d="M388 180h46" stroke="var(--st-building)" stroke-width="1.5" />
      <rect x="434" y="150" width="96" height="60" rx="10" fill="var(--surface)" stroke="var(--border-strong)" />
      <text x="452" y="185">ffmpeg</text>
      <path d="M530 180h30" stroke="var(--st-building)" stroke-width="1.5" />
      <rect x="560" y="140" width="56" height="80" rx="6" fill="var(--accent-soft)" stroke="var(--accent)" />
      <path d="M580 168l18 12-18 12z" fill="var(--accent)" />
    </g>
  )}

  {id === 'lead-engine' && (
    <g font-family="var(--font-mono)" font-size="11" fill="var(--text-2)">
      <rect x="40" y="40" width="560" height="280" rx="12" fill="var(--surface)" stroke="var(--border-strong)" />
      <rect x="40" y="40" width="560" height="40" rx="12" fill="var(--surface-2)" />
      {['company', 'industry', 'fit', 'priority'].map((h, i) => <text x={64 + i * 140} y="65" fill="var(--text-3)">{h}</text>)}
      {[0, 1, 2, 3, 4].map((r) => (
        <g transform={`translate(0 ${100 + r * 42})`}>
          <rect x="64" y="-8" width={90 - r * 8} height="10" rx="3" fill="var(--border-strong)" />
          <rect x="204" y="-8" width="70" height="10" rx="3" fill="var(--border)" />
          <rect x="344" y="-8" width="80" height="10" rx="5" fill="var(--border)" />
          <rect x="344" y="-8" width={80 - r * 14} height="10" rx="5" fill="var(--st-prototype)" opacity="0.8" />
          <circle cx="490" cy="-3" r="5" fill={r < 2 ? 'var(--accent)' : 'var(--border-strong)'} />
          <line x1="64" y1="16" x2="576" y2="16" stroke="var(--border)" />
        </g>
      ))}
    </g>
  )}

  {id === 'crm' && (
    <g font-family="var(--font-mono)" font-size="11" fill="var(--text-3)">
      <rect x="40" y="40" width="110" height="280" rx="10" fill="var(--surface)" stroke="var(--border-strong)" />
      {[0, 1, 2, 3, 4, 5].map((i) => <rect x="56" y={64 + i * 30} width={i === 2 ? 78 : 60} height="9" rx="3" fill={i === 2 ? 'var(--text-2)' : 'var(--border-strong)'} />)}
      {[0, 1, 2, 3].map((c) => (
        <g transform={`translate(${170 + c * 110} 40)`}>
          <rect width="100" height="280" rx="10" fill="var(--surface)" stroke="var(--border)" />
          <rect x="12" y="14" width="50" height="8" rx="3" fill="var(--border-strong)" />
          {Array.from({ length: 4 - c + (c === 3 ? 1 : 0) }).map((_, k) => (
            <rect x="10" y={36 + k * 52} width="80" height="42" rx="7" fill="var(--surface-2)" stroke={c === 1 && k === 0 ? 'var(--accent)' : 'var(--border)'} />
          ))}
        </g>
      ))}
    </g>
  )}

  {!['content-engine', 'lead-engine', 'crm'].includes(id) && (
    <g>
      <rect x="120" y="70" width="400" height="220" rx="12" fill="var(--surface)" stroke="var(--border-strong)" />
      <rect x="150" y="104" width="180" height="16" rx="4" fill="var(--border-strong)" />
      <rect x="150" y="134" width="300" height="9" rx="3" fill="var(--border)" />
      <rect x="150" y="152" width="260" height="9" rx="3" fill="var(--border)" />
      <rect x="150" y="200" width="100" height="32" rx="7" fill="var(--text-2)" />
    </g>
  )}
</svg>

<style>
  .glyph { width: 100%; height: 100%; }
</style>
