---
import type { CardProfile } from '../../data/cards';
import { cardUrl, vcardPath, fullName } from '../../data/cards';
import { qrSvg } from '../../lib/qr';

interface Props { profile: CardProfile }
const { profile: p } = Astro.props;
const url = cardUrl(p);
const qr = await qrSvg(url);
const name = fullName(p);
const host = (href: string) => href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const icons = {
  phone: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1Z',
  mail: 'M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5Zm1.7.2 7.3 5.6 7.3-5.6',
  web: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-9 9h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9M12 3C9.5 5.7 8.2 8.7 8.2 12s1.3 6.3 3.8 9',
  save: 'M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19h14',
};
const linkIcon: Record<string, string> = {
  linkedin: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z',
  github: 'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z',
};
---

<article class="bcard" data-card={p.slug} style={p.accent ? `--accent:${p.accent}` : undefined} aria-labelledby="bc-name">
  <header class="id">
    <div class="mono-mark" aria-hidden="true">{p.initials}</div>
    <h1 id="bc-name">{name}</h1>
    <p class="title mono">
      {p.title.split('|').map((part, i) => (
        <>{i > 0 && <span class="sep" aria-hidden="true"> · </span>}<span class="tp">{part.trim()}</span></>
      ))}
    </p>
    {p.bio && <p class="bio">{p.bio}</p>}
  </header>

  <a class="btn btn-primary save" data-save href={vcardPath(p)} download={`${p.slug}.vcf`} type="text/vcard">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={icons.save} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    Save contact
  </a>

  <nav class="actions" aria-label="Contact">
    {/* Filled in only from the private share link; the public page never contains a number. */}
    <a class="act" data-call hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={icons.phone} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg>
      <span class="al">Call</span><span class="av mono" data-call-number></span>
    </a>
    {p.email && (
      <a class="act" href={`mailto:${p.email}`}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={icons.mail} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg>
        <span class="al">Email</span><span class="av mono">{p.email}</span>
      </a>
    )}
    {p.website && (
      <a class="act" href={p.website}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={icons.web} fill="none" stroke="currentColor" stroke-width="1.7" /></svg>
        <span class="al">Website</span><span class="av mono">{host(p.website)}</span>
      </a>
    )}
  </nav>

  {p.links.length > 0 && (
    <ul class="links" aria-label="Profiles">
      {p.links.map((l) => (
        <li>
          <a href={l.href} {...(l.kind === 'web' ? {} : { target: '_blank', rel: 'noopener me' })}>
            {linkIcon[l.kind] ? (
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d={linkIcon[l.kind]} fill="currentColor" /></svg>
            ) : (
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d={icons.web} fill="none" stroke="currentColor" stroke-width="1.7" /></svg>
            )}
            <span>{l.label}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  )}

  <figure class="qr">
    <div class="qr-tile" data-qr role="img" aria-label={`QR code linking to ${url}`} set:html={qr} />
    <figcaption>
      <span class="eyebrow">Scan to share</span>
      <span class="mono qr-url" set:html={host(url).replace('/', '<wbr>/')} />
    </figcaption>
  </figure>
</article>

<script>
  // Private share link: /card/#k=<key>. The key never leaves the browser except as a derived file id.
  // Must match privateId() in src/lib/cardPrivate.ts: sha256("<slug>:<key>"), first 32 hex chars.
  async function unlock(card: HTMLElement) {
    const key = new URLSearchParams(location.hash.slice(1)).get('k');
    if (!key || !crypto?.subtle) return;
    const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(`${card.dataset.card}:${key}`));
    const id = [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('').slice(0, 32);
    const res = await fetch(`/card/p/${id}.json`, { cache: 'no-store' }).catch(() => null);
    if (!res?.ok) return;
    const data: { phone: string; phoneDisplay: string; vcf: string; qr: string } = await res.json();

    const call = card.querySelector<HTMLAnchorElement>('[data-call]');
    if (call) {
      call.href = `tel:${data.phone}`;
      call.querySelector('[data-call-number]')!.textContent = data.phoneDisplay;
      call.hidden = false;
    }
    card.querySelector<HTMLAnchorElement>('[data-save]')?.setAttribute('href', data.vcf);
    const qr = card.querySelector<HTMLElement>('[data-qr]');
    if (qr) {
      qr.innerHTML = data.qr;
      qr.setAttribute('aria-label', 'QR code for this card, including the phone number');
    }
  }
  const run = () => document.querySelectorAll<HTMLElement>('[data-card]').forEach((c) => void unlock(c));
  run();
  // Opening the private link in a tab that already shows the card only changes the hash.
  addEventListener('hashchange', run);
</script>

<style>
  .bcard {
    width: 100%; max-width: 440px; margin-inline: auto;
    display: grid; gap: 18px;
    padding: clamp(22px, 6vw, 32px);
    background: var(--surface); border: 1px solid var(--border); border-radius: 22px; box-shadow: var(--shadow);
  }
  .id { display: grid; justify-items: center; text-align: center; gap: 6px; padding-top: 6px; }
  .mono-mark {
    display: grid; place-items: center; width: 92px; height: 92px; border-radius: 24px; margin-bottom: 10px;
    border: 1px solid var(--border-strong); background: var(--bg-elev);
    font: 600 1.85rem/1 var(--font-mono); letter-spacing: 0.02em; color: var(--text);
    box-shadow: 0 0 0 6px var(--accent-soft);
  }
  h1 { font-size: clamp(1.7rem, 7vw, 2.1rem); letter-spacing: -0.03em; }
  .title { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--accent); line-height: 1.6; }
  .tp { white-space: nowrap; }
  .sep { color: var(--text-3); }
  .bio { color: var(--text-2); font-size: 0.98rem; margin-top: 4px; }

  .save { justify-content: center; width: 100%; padding: 16px 18px; font-size: 1.02rem; font-weight: 600; border-radius: 14px; }

  .actions { display: grid; gap: 8px; }
  .act {
    display: grid; grid-template-columns: 40px auto 1fr; align-items: center; gap: 4px 12px;
    padding: 12px 14px; min-height: 56px; border-radius: 14px; text-decoration: none;
    border: 1px solid var(--border); background: var(--bg-elev); color: var(--text);
    transition: border-color 0.15s var(--ease), background 0.15s var(--ease);
  }
  .act svg { justify-self: center; color: var(--accent); }
  .act:hover { border-color: var(--border-strong); background: var(--surface-2); }
  .al { font-weight: 600; font-size: 0.95rem; }
  .av { justify-self: end; font-size: 0.78rem; color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }

  .links { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .links a {
    display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 12px 6px; min-height: 64px;
    border-radius: 12px; border: 1px solid var(--border); text-decoration: none; color: var(--text-2); font-size: 0.82rem; font-weight: 500;
    position: relative; transition: color 0.15s, border-color 0.15s;
  }
  .links a:hover { color: var(--text); border-color: var(--border-strong); }
  .links .arrow { position: absolute; top: 6px; right: 8px; font-size: 0.65rem; color: var(--text-3); }

  .qr { margin: 6px 0 0; display: flex; align-items: center; gap: 16px; padding-top: 18px; border-top: 1px solid var(--border); }
  .qr-tile { width: 116px; flex: none; background: #fff; border-radius: 10px; padding: 2px; }
  .qr-tile :global(svg) { width: 100%; height: auto; display: block; }
  .qr figcaption { display: grid; gap: 4px; min-width: 0; }
  .qr .eyebrow { margin: 0; }
  .qr-url { font-size: 0.78rem; color: var(--text-2); }

  @media (max-width: 360px) {
    .act { grid-template-columns: 32px 1fr; }
    .av { grid-column: 2; justify-self: start; }
  }
</style>
