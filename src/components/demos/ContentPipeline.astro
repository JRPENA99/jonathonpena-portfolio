---
/**
 * Architecture view of the Content Engine as it stands. Node states are honest:
 * working = runs today (locally), planned = not built yet.
 */
const inputs = [
  { label: 'Asset library', detail: 'scenes, overlays + masks, audio loops', state: 'working' },
  { label: 'Project settings', detail: 'scene, layers, length, format, fades', state: 'working' },
  { label: 'User uploads', detail: 'validated, with quotas', state: 'planned' },
];
const core = [
  { label: 'Web app', detail: 'accounts, projects, create / edit', state: 'working' },
  { label: 'Render queue', detail: 'SQLite, per-user limits', state: 'working' },
  { label: 'Python worker', detail: 'translates settings → engine project, reports progress', state: 'working' },
  { label: 'Render engine', detail: 'composite, audio mix, segments + cache', state: 'working' },
  { label: 'FFmpeg', detail: 'encode loop once, join by stream copy', state: 'working' },
  { label: 'MP4 output', detail: '10 s to 3 h · 16:9 or 9:16', state: 'working' },
];
const stateLabel: Record<string, string> = { working: 'Working', planned: 'Planned' };
---

<figure class="cp" data-reveal>
  <div class="cp-head">
    <p class="eyebrow">Architecture · current</p>
    <ul class="legend" aria-label="Legend">
      <li><span class="sw working"></span>Working (locally)</li>
      <li><span class="sw planned"></span>Planned</li>
    </ul>
  </div>

  <div class="diagram">
    <ul class="inputs" aria-label="Inputs">
      {inputs.map((n) => (
        <li class:list={['node', n.state]}>
          <span class="nl">{n.label}</span>
          <span class="nd">{n.detail}</span>
          <span class="ns mono">{stateLabel[n.state]}</span>
        </li>
      ))}
    </ul>

    <svg class="join" viewBox="0 0 80 300" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 50 C 40 50, 40 150, 80 150" />
      <path d="M0 150 L 80 150" />
      <path d="M0 250 C 40 250, 40 150, 80 150" class="dash-planned" />
    </svg>

    <ol class="core" aria-label="Pipeline">
      {core.map((n, i) => (
        <li class:list={['node', n.state, { out: i === core.length - 1 }]}>
          <span class="nl">{n.label}</span>
          <span class="nd">{n.detail}</span>
        </li>
      ))}
    </ol>
  </div>

  <figcaption class="cap">
    Everything above runs end to end on a development machine. Not built yet: user uploads, payments, and public hosting.
  </figcaption>
</figure>

<style>
  .cp { margin: 0; border: 1px solid var(--border-strong); border-radius: 16px; background: var(--bg-elev); padding: clamp(18px, 3vw, 30px); }
  .cp-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 22px; }
  .cp-head .eyebrow { margin: 0; }
  .legend { display: flex; gap: 16px; list-style: none; margin: 0; padding: 0; font-size: 0.78rem; color: var(--text-2); }
  .legend li { display: flex; align-items: center; gap: 6px; }
  .sw { width: 10px; height: 10px; border-radius: 3px; border: 1.5px solid var(--st-live); }
  .sw.planned { border-color: var(--st-concept); border-style: dashed; }

  .diagram { display: grid; grid-template-columns: minmax(0, 1fr) 64px minmax(0, 2.6fr); align-items: center; }
  .inputs { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .node {
    position: relative; display: grid; gap: 2px; padding: 12px 14px; border-radius: 10px;
    background: var(--surface); border: 1px solid var(--border-strong); min-width: 0;
  }
  .node.working { box-shadow: inset 3px 0 0 var(--st-live); }
  .node.planned { border-style: dashed; border-color: var(--st-concept); opacity: 0.8; }
  .nl { font-weight: 600; font-size: 0.9rem; }
  .nd { font-size: 0.76rem; color: var(--text-2); line-height: 1.4; }
  .ns { position: absolute; top: 10px; right: 12px; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); }
  .inputs .working .ns { display: none; }

  .join { width: 100%; height: 100%; min-height: 220px; }
  .join path { fill: none; stroke: var(--border-strong); stroke-width: 1.5; vector-effect: non-scaling-stroke; stroke-dasharray: 4 4; animation: dash 1s linear infinite; }
  .join .dash-planned { stroke: var(--st-concept); opacity: 0.5; animation: none; }

  .core { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px 26px; }
  .core .node:not(:last-child):not(:nth-child(3))::after {
    content: ''; position: absolute; left: 100%; top: 50%; width: 26px; height: 1.5px;
    background: linear-gradient(90deg, var(--st-live) 50%, transparent 50%) 0 0 / 8px 1.5px; animation: flowx 0.8s linear infinite;
  }
  .core .node:nth-child(3)::after {
    content: '↩'; position: absolute; left: 50%; top: 100%; transform: translate(-50%, 1px); color: var(--text-3); font-size: 0.8rem;
  }
  .core .out { background: linear-gradient(var(--accent-soft), var(--accent-soft)), var(--surface); border-color: color-mix(in srgb, var(--accent) 50%, var(--border)); }
  .cap { margin-top: 22px; font-size: 0.88rem; color: var(--text-2); max-width: 70ch; }

  @keyframes dash { to { stroke-dashoffset: -8; } }
  @keyframes flowx { to { background-position: 8px 0; } }

  @media (max-width: 900px) {
    .diagram { grid-template-columns: 1fr; gap: 0; }
    .join { display: none; }
    .inputs { padding-bottom: 30px; position: relative; }
    .inputs::after { content: '↓'; position: absolute; bottom: 4px; left: 50%; color: var(--text-3); }
    .core { grid-template-columns: 1fr; gap: 20px; }
    .core .node:not(:last-child)::after, .core .node:nth-child(3)::after {
      content: ''; left: 24px; top: 100%; width: 1.5px; height: 20px; transform: none;
      background: linear-gradient(180deg, var(--st-live) 50%, transparent 50%) 0 0 / 1.5px 8px; animation: none;
    }
  }
</style>
