---
import { Image } from 'astro:assets';
import { render, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getBuildLog, formatDate } from '../../lib/content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const log = await getBuildLog();
  return log.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: log[i - 1], older: log[i + 1] },
  }));
}

const { entry, newer, older } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const project = d.project ? await getEntry(d.project) : undefined;
const schema = [{
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.summary,
  datePublished: d.date.toISOString(), author: { '@type': 'Person', name: site.name, url: site.url },
  url: new URL(`/build/${entry.id}/`, site.url).href,
}];
---

<Base title={d.title} description={d.summary} ogType="article" publishedTime={d.date} schema={schema}>
  <article class="wrap wrap-narrow post">
    <a class="text-link back" href="/build/">← Build log</a>
    <div class="meta">
      <time class="mono" datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
      {project && <a class="mono proj" href={`/projects/${project.id}/`}>{project.data.title}</a>}
      {d.status && <StatusBadge status={d.status} />}
    </div>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    {d.images.map((img) => (
      <figure class="shot"><Image src={img.src} alt={img.alt} widths={[640, 1200, 1600]} sizes="(max-width: 800px) 100vw, 760px" /><figcaption>{img.alt}</figcaption></figure>
    ))}
    <div class="prose"><Content /></div>
    {d.tags.length > 0 && <ul class="tags tagrow">{d.tags.map((t) => <li class="tag">{t}</li>)}</ul>}
    <nav class="pn" aria-label="More log entries">
      {older ? <a href={`/build/${older.id}/`}><span class="eyebrow">Older</span>{older.data.title}</a> : <span />}
      {newer && <a href={`/build/${newer.id}/`} class="r"><span class="eyebrow">Newer</span>{newer.data.title}</a>}
    </nav>
  </article>
</Base>

<style>
  .post { padding-block: clamp(36px, 6vw, 72px) clamp(64px, 9vw, 104px); }
  .back { color: var(--text-2); margin-bottom: 32px; }
  .meta { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin-bottom: 18px; font-size: 0.75rem; }
  .meta time { color: var(--text-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .proj { text-transform: uppercase; letter-spacing: 0.07em; text-decoration: none; }
  .proj:hover { color: var(--accent); }
  h1 { font-size: clamp(2rem, 4.4vw, 3rem); }
  .lede { margin: 18px 0 36px; }
  .shot { margin: 0 0 36px; }
  .shot :global(img) { border-radius: var(--radius-sm); border: 1px solid var(--border); }
  .shot figcaption { font-size: 0.8rem; color: var(--text-3); margin-top: 8px; }
  .tagrow { margin-top: 40px; }
  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--border); }
  .pn a { display: grid; gap: 4px; text-decoration: none; font-weight: 500; }
  .pn a:hover { color: var(--accent); }
  .pn .eyebrow { margin: 0; }
  .pn .r { text-align: right; }
  @media (max-width: 560px) { .pn { grid-template-columns: 1fr; } .pn .r { text-align: left; } }
</style>
