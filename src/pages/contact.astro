---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const subject = encodeURIComponent('Something I want to build');
const body = encodeURIComponent('Hi Jonathon,\n\nWhat I\'m working on:\n\nWhat\'s not working today:\n\nTimeline (if any):\n');
const mailto = `mailto:${site.email}?subject=${subject}&body=${body}`;

const topics = [
  { t: 'Websites', d: 'Brand and business sites built around one clear goal.' },
  { t: 'Landing pages', d: 'A focused page for a launch, product or offer.' },
  { t: 'Dashboards', d: 'Turning scattered data into a view you can act on.' },
  { t: 'Automation', d: 'Removing the repetitive steps from a process.' },
  { t: 'Internal tools', d: 'Small software for how your team actually works.' },
  { t: 'Data workflows', d: 'Getting information from where it is to where it\'s useful.' },
  { t: 'Product prototypes', d: 'Taking an idea to something clickable, quickly.' },
  { t: 'Interesting ideas', d: 'If it\'s a real problem, I\'d like to hear it.' },
];
---

<Base title="Contact" description="Have something you want to build? Contact Jonathon Pena about websites, dashboards, automation, internal tools and product prototypes.">
  <section class="wrap contact">
    <div class="intro">
      <p class="eyebrow">Contact</p>
      <h1>Have something you want to build?</h1>
      <p class="lede">
        If you've got an idea, a messy workflow, or something you think should work better, I'd like to hear about it.
        It's just me, so you'll be talking to the person who builds it.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={mailto}>Start a conversation <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <dl class="direct">
        <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt>LinkedIn</dt><dd><a href={site.linkedin} target="_blank" rel="noopener">in/jonathon-pena ↗</a></dd></div>
        <div><dt>GitHub</dt><dd><a href={site.github} target="_blank" rel="noopener">JRPENA99 ↗</a></dd></div>
        <div><dt>Based in</dt><dd>{site.location}</dd></div>
      </dl>
    </div>

    <div class="topics">
      <p class="eyebrow">Open to conversations about</p>
      <ul>
        {topics.map((x) => <li><strong>{x.t}</strong><span>{x.d}</span></li>)}
      </ul>
      <div class="tip card">
        <p class="eyebrow">Helpful to include</p>
        <p class="muted">What you're working on, what isn't working today, and any timeline. A rough description is plenty to start.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(40px, 7vw, 96px); padding-block: clamp(56px, 9vw, 112px); }
  h1 { max-width: 13ch; }
  .lede { margin-top: 22px; }
  .actions { margin-top: 32px; }
  .direct { margin: 44px 0 0; display: grid; gap: 0; }
  .direct div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-top: 1px solid var(--border); flex-wrap: wrap; }
  .direct dt { color: var(--text-3); font-size: 0.88rem; }
  .direct dd { margin: 0; font-family: var(--font-mono); font-size: 0.86rem; }
  .direct a { text-decoration: none; }
  .direct a:hover { color: var(--accent); }
  .topics ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .topics li { background: var(--bg); padding: 16px; display: grid; gap: 4px; }
  .topics strong { font-weight: 600; font-size: 0.95rem; }
  .topics span { font-size: 0.84rem; color: var(--text-2); }
  .tip { margin-top: 16px; padding: 18px; }
  .tip .eyebrow { margin-bottom: 6px; }
  .tip .muted { font-size: 0.9rem; }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
  @media (max-width: 440px) { .topics ul { grid-template-columns: 1fr; } }
</style>
