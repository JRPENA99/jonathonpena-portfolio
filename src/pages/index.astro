---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import LogEntry from '../components/LogEntry.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { site, capabilities, toolkit } from '../data/site';
import { getProjects, getBuildLog, getWriting, formatMonth } from '../lib/content';
import portrait from '../assets/jonathon.png';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const current = projects.filter((p) => p.data.current);
const log = await getBuildLog();
const writing = (await getWriting()).slice(0, 3);
const latestFor = (id: string) => log.find((e) => e.data.project?.id === id);

const approach = ['Understand the problem', 'Map the process', 'Find the friction', 'Design the system', 'Prototype', 'Test', 'Improve'];
---

<Base>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="name mono">Jonathon Pena <span aria-hidden="true">/</span> <span class="loc">{site.location}</span></p>
      <h1>I turn messy processes into <span class="hl">useful systems.</span></h1>
      <p class="lede">
        I build software, automation, dashboards and websites around real operational and business problems: the kind I've
        spent years working inside of, not just reading about.
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href="/projects/">View my work <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn" href="#building">What I'm building</a>
      </div>
      <ul class="socials">
        <li><a href={site.github} rel="me noopener" target="_blank">GitHub ↗</a></li>
        <li><a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn ↗</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>

    <aside class="now card" aria-labelledby="now-h">
      <div class="now-head">
        <p id="now-h" class="eyebrow">Now</p>
        <span class="mono upd">Updated {formatMonth(log[0].data.date)}</span>
      </div>
      <ul>
        {projects.filter((p) => p.data.current || p.data.status === 'live').filter((p) => p.data.caseStudy).map((p) => (
          <li>
            <a href={`/projects/${p.id}/`}>
              <span class="nt">{p.data.title}</span>
              <StatusBadge status={p.data.status} />
            </a>
          </li>
        ))}
      </ul>
      {log[0] && (
        <a class="latest" href={`/build/${log[0].id}/`}>
          <span class="eyebrow">Latest log</span>
          <span class="lt">{log[0].data.title} →</span>
        </a>
      )}
    </aside>
  </section>

  <section class="section" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 id="work-h">Things I've built and am building</h2>
        </div>
        <a class="text-link" href="/projects/">All projects →</a>
      </div>
      <div class="work-grid">
        {featured.map((p, i) => <div class:list={{ wide: i === 0 }}><ProjectCard project={p} large={i === 0} /></div>)}
      </div>
    </div>
  </section>

  <section class="section building" id="building" aria-labelledby="building-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Currently building</p>
          <h2 id="building-h">On the bench right now</h2>
          <p class="lede">Unfinished on purpose. Each one is labeled with where it actually stands.</p>
        </div>
      </div>
      <ol class="bench">
        {current.map((p) => {
          const last = latestFor(p.id);
          return (
            <li class="bench-item" data-reveal>
              <div class="bi-head">
                <StatusBadge status={p.data.status} note={p.data.statusNote} />
                <span class="mono bi-type">{p.data.type}</span>
              </div>
              <h3><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
              <p class="muted">{p.data.summary}</p>
              {last && (
                <a class="bi-log" href={`/build/${last.id}/`}>
                  <span class="mono">{formatMonth(last.data.date)}</span>
                  <span>{last.data.title}</span>
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="cap-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Capabilities</p>
          <h2 id="cap-h">What I actually do</h2>
          <p class="lede">Operations taught me to understand the workflow before touching the software. Everything below starts there.</p>
        </div>
      </div>
      <div class="caps">
        {capabilities.map((c, i) => (
          <article class="cap" data-reveal>
            <span class="mono cap-n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{c.title}</h3>
            <p class="muted">{c.body}</p>
            <ul class="tags">{c.examples.map((e) => <li class="tag">{e}</li>)}</ul>
          </article>
        ))}
        <article class="cap approach" data-reveal>
          <span class="mono cap-n">How I work</span>
          <ol>{approach.map((s) => <li>{s}</li>)}</ol>
        </article>
      </div>

      <div class="toolkit" data-reveal>
        <p class="eyebrow">Toolkit</p>
        <dl>
          {toolkit.map((g) => (
            <div>
              <dt>{g.group}</dt>
              <dd>{g.items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="log-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Build log</p>
          <h2 id="log-h">Recent progress</h2>
          <p class="lede">An engineering notebook: what I did, what broke, what's next.</p>
        </div>
        <a class="text-link" href="/build/">Full log →</a>
      </div>
      <div>{log.slice(0, 4).map((e) => <LogEntry entry={e} />)}</div>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Writing</p>
          <h2 id="writing-h">What I'm thinking about</h2>
        </div>
        <a class="text-link" href="/writing/">All writing →</a>
      </div>
      <div class="grid grid-3">{writing.map((a) => <ArticleCard article={a} />)}</div>
    </div>
  </section>

  <section class="section" aria-labelledby="me-h">
    <div class="wrap me" data-reveal>
      <Image src={portrait} alt="Jonathon Pena" widths={[160, 320]} sizes="160px" class="me-img" loading="lazy" />
      <div>
        <h2 id="me-h" class="me-h">I'm Jonathon. I like figuring out how things work, especially when they're harder than they need to be.</h2>
        <a class="text-link" href="/about/">More about how I work →</a>
      </div>
    </div>
  </section>

  <ContactCTA />
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr); gap: clamp(32px, 5vw, 72px);
    align-items: center; padding-block: clamp(56px, 10vw, 120px) clamp(56px, 8vw, 96px);
  }
  .name { font-size: 0.82rem; color: var(--text-2); margin-bottom: 22px; letter-spacing: 0.02em; }
  .name .loc, .name span[aria-hidden] { color: var(--text-3); }
  .hero h1 { max-width: 15ch; }
  .hl { color: var(--text-2); }
  .hero .lede { margin-top: 24px; max-width: 54ch; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 32px; }
  .socials { display: flex; gap: 20px; flex-wrap: wrap; list-style: none; padding: 0; margin: 28px 0 0; font-size: 0.88rem; }
  .socials a { color: var(--text-2); text-decoration: none; }
  .socials a:hover { color: var(--text); }
  .socials li:last-child a { font-family: var(--font-mono); font-size: 0.82rem; }

  .now { padding: 22px; }
  .now-head { display: flex; justify-content: space-between; align-items: baseline; }
  .now-head .eyebrow { margin: 0; }
  .upd { font-size: 0.7rem; color: var(--text-3); }
  .now ul { list-style: none; margin: 14px 0 0; padding: 0; }
  .now li a {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    padding: 12px 0; border-top: 1px solid var(--border); text-decoration: none;
  }
  .now li a:hover .nt { color: var(--accent); }
  .nt { font-weight: 500; font-size: 0.95rem; transition: color 0.15s; }
  .latest {
    display: grid; gap: 4px; margin-top: 10px; padding: 14px; border-radius: 10px;
    background: var(--surface-2); text-decoration: none;
  }
  .latest .eyebrow { margin: 0; font-size: 0.66rem; }
  .lt { font-size: 0.9rem; }
  .latest:hover .lt { color: var(--accent); }

  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .work-grid .wide { grid-column: 1 / -1; }
  .work-grid .wide :global(.project) { flex-direction: row; }
  .work-grid .wide :global(.media) { flex: 1.3; aspect-ratio: auto; min-height: 340px; border-bottom: 0; border-right: 1px solid var(--border); }
  .work-grid .wide :global(.body) { flex: 1; padding: 28px; justify-content: center; }

  .building { background: var(--bg-sunk); }
  .bench { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .bench-item { display: grid; gap: 10px; align-content: start; padding: 22px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); }
  .bi-head { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: center; }
  .bi-type { font-size: 0.7rem; color: var(--text-3); }
  .bench-item h3 a { text-decoration: none; }
  .bench-item h3 a:hover { color: var(--accent); }
  .bench-item .muted { font-size: 0.93rem; }
  .bi-log {
    display: grid; gap: 2px; margin-top: 6px; padding-top: 12px; border-top: 1px dashed var(--border-strong);
    text-decoration: none; font-size: 0.88rem;
  }
  .bi-log .mono { font-size: 0.68rem; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .bi-log:hover span:last-child { color: var(--accent); }

  .caps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--border); border-left: 1px solid var(--border); }
  .cap { padding: 26px; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); display: grid; gap: 10px; align-content: start; }
  .cap-n { font-size: 0.7rem; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .cap .muted { font-size: 0.94rem; }
  .cap .tags { margin-top: 6px; }
  .approach { background: var(--bg-sunk); }
  .approach ol { margin: 4px 0 0; padding: 0; list-style: none; counter-reset: s; display: grid; gap: 6px; }
  .approach li { counter-increment: s; font-size: 0.92rem; display: flex; gap: 10px; align-items: baseline; }
  .approach li::before { content: counter(s); font: 0.68rem var(--font-mono); color: var(--accent); width: 14px; }

  .toolkit { margin-top: 40px; }
  .toolkit dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 20px; margin: 0; }
  .toolkit dt { font-size: 0.8rem; font-weight: 600; margin-bottom: 4px; }
  .toolkit dd { margin: 0; font-size: 0.88rem; color: var(--text-2); }

  .me { display: flex; align-items: center; gap: clamp(20px, 4vw, 40px); }
  .me :global(.me-img) { width: clamp(96px, 14vw, 140px); height: auto; border-radius: 50%; flex: none; }
  .me-h { font-size: clamp(1.25rem, 2.4vw, 1.7rem); max-width: 34ch; margin-bottom: 14px; font-weight: 500; }

  @media (max-width: 960px) {
    .caps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; }
    .work-grid { grid-template-columns: 1fr; }
    .work-grid .wide :global(.project) { flex-direction: column; }
    .work-grid .wide :global(.media) { min-height: 0; aspect-ratio: 16 / 9; border-right: 0; border-bottom: 1px solid var(--border); }
    .work-grid .wide :global(.body) { padding: 20px; }
  }
  @media (max-width: 600px) {
    .caps { grid-template-columns: 1fr; }
    .me { flex-direction: column; align-items: flex-start; }
  }
</style>
