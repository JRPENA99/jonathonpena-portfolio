---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import FlowDiagram from '../../components/FlowDiagram.astro';
import LogEntry from '../../components/LogEntry.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Demo from '../../components/demos/Demo.astro';
import Timeline from '../../components/Timeline.astro';
import { getProjects, getBuildLog, statusLabel } from '../../lib/content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.filter((p) => p.data.caseStudy).map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const log = (await getBuildLog()).filter((e) => e.data.project?.id === project.id);

const all = (await getProjects()).filter((p) => p.data.caseStudy);
const i = all.findIndex((p) => p.id === project.id);
const next = all[(i + 1) % all.length];

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  description: d.summary,
  creator: { '@type': 'Person', name: site.name, url: site.url },
  dateCreated: d.year,
  keywords: d.tech.join(', '),
  url: new URL(`/projects/${project.id}/`, site.url).href,
}];
---

<Base title={d.title} description={d.summary} schema={schema}>
  <article>
    <header class="wrap cs-head">
      <a class="back text-link" href="/projects/">← Projects</a>
      <div class="badge"><StatusBadge status={d.status} note={d.statusNote} size="md" /></div>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <dl class="facts">
        <div><dt>Status</dt><dd>{statusLabel[d.status]}{d.statusNote && ` · ${d.statusNote}`}</dd></div>
        <div><dt>Year</dt><dd>{d.year}</dd></div>
        <div><dt>Type</dt><dd>{d.type}</dd></div>
      </dl>
      {d.links.length > 0 && (
        <div class="links">
          {d.links.map((l) => (
            <a class:list={['btn', { 'btn-primary': l.primary }]} href={l.href} target="_blank" rel="noopener">
              {l.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      )}
    </header>

    {d.cover && (
      <div class="wrap cover" data-reveal>
        <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 1024, 1600, 2200]} sizes="(max-width: 1200px) 100vw, 1100px" loading="eager" fetchpriority="high" />
      </div>
    )}

    {(d.workflow || d.demo || d.gallery.length > 0) && (
      <section class="wrap visuals" aria-label="Architecture and interface">
        {d.workflow && <FlowDiagram steps={d.workflow} title={d.workflowTitle ?? 'Workflow'} />}
        {d.gallery.length > 0 && (
          <div>
            <p class="eyebrow">Interface</p>
            <div class="gallery">
              {d.gallery.map((g) => (
                <figure class:list={['shot', { narrow: g.narrow }]} data-reveal>
                  <Image src={g.src} alt={g.alt} widths={g.narrow ? [360, 720] : [640, 1024, 1600]} sizes={g.narrow ? '(max-width: 860px) 70vw, 300px' : '(max-width: 860px) 100vw, 800px'} loading="lazy" />
                  {g.caption && <figcaption>{g.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </div>
        )}
        {d.demo && (
          <div class="demo">
            <p class="eyebrow">{d.demo === 'content-pipeline' ? 'Architecture' : 'Interface'}</p>
            <Demo name={d.demo} />
          </div>
        )}
      </section>
    )}

    {d.timeline.length > 0 && (
      <div class="wrap timeline-wrap">
        <Timeline stages={d.timeline} title={`How ${d.title} got here`} />
      </div>
    )}

    <div class="wrap body">
      <div class="prose"><Content /></div>
      <aside class="side">
        <div class="side-block">
          <p class="eyebrow">Technology</p>
          <ul class="tags">{d.tech.map((t) => <li class="tag">{t}</li>)}</ul>
        </div>
        {d.links.length > 0 && (
          <div class="side-block">
            <p class="eyebrow">Links</p>
            <ul class="ll">{d.links.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a></li>)}</ul>
          </div>
        )}
        {log.length > 0 && (
          <div class="side-block">
            <p class="eyebrow">Build log</p>
            <p class="muted small">{log.length} {log.length === 1 ? 'entry' : 'entries'} for this project, below.</p>
          </div>
        )}
      </aside>
    </div>

    {log.length > 0 && (
      <section class="section" aria-labelledby="plog-h">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow">Build log</p>
              <h2 id="plog-h">Progress on {d.title}</h2>
            </div>
            <a class="text-link" href={`/build/?project=${project.id}`}>Filter the full log →</a>
          </div>
          {log.map((e) => <LogEntry entry={e} />)}
        </div>
      </section>
    )}

    {next && next.id !== project.id && (
      <nav class="wrap next" aria-label="Next project">
        <a href={`/projects/${next.id}/`} class="card next-card">
          <span class="eyebrow">Next project</span>
          <span class="nt">{next.data.title} →</span>
          <StatusBadge status={next.data.status} />
        </a>
      </nav>
    )}
  </article>

  <ContactCTA />
</Base>

<style>
  .cs-head { padding-block: clamp(36px, 6vw, 72px) clamp(28px, 4vw, 44px); }
  .back { color: var(--text-2); margin-bottom: 36px; }
  .badge { margin-bottom: 18px; }
  h1 { max-width: 18ch; }
  .lede { margin-top: 18px; }
  .facts { display: flex; flex-wrap: wrap; gap: 14px 44px; margin: 32px 0 0; padding-top: 20px; border-top: 1px solid var(--border); }
  .facts dt { font: 0.68rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-3); margin-bottom: 4px; }
  .facts dd { margin: 0; font-size: 0.95rem; }
  .links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }

  .cover :global(img) { width: 100%; border-radius: var(--radius); border: 1px solid var(--border); }
  .visuals { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(32px, 5vw, 56px); padding-block: clamp(32px, 5vw, 56px); }

  .timeline-wrap { padding-block: clamp(40px, 6vw, 72px) clamp(8px, 2vw, 16px); border-top: 1px solid var(--border); }
  .gallery { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 300px); gap: 16px; align-items: start; }
  .gallery .shot:not(.narrow) { grid-column: 1; }
  .gallery .narrow { grid-column: 2; grid-row: 1 / span 2; }
  .shot { margin: 0; }
  .shot :global(img) { width: 100%; height: auto; border-radius: var(--radius); border: 1px solid var(--border); }
  .shot figcaption { font-size: 0.82rem; color: var(--text-3); margin-top: 8px; }
  @media (max-width: 860px) {
    .gallery { grid-template-columns: minmax(0, 1fr); }
    .gallery .shot, .gallery .narrow { grid-column: 1; grid-row: auto; }
    .gallery .narrow { width: min(300px, 80%); }
  }

  .body { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: clamp(32px, 6vw, 80px); padding-block: clamp(24px, 4vw, 48px) clamp(64px, 9vw, 104px); }
  .prose { max-width: 70ch; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .side { position: sticky; top: 96px; align-self: start; display: grid; gap: 28px; }
  .side-block .eyebrow { margin-bottom: 10px; }
  .ll { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 0.92rem; }
  .small { font-size: 0.88rem; }

  .next { padding-bottom: clamp(48px, 7vw, 80px); }
  .next-card { display: grid; gap: 8px; padding: 26px; }
  .nt { font-size: 1.4rem; font-weight: 600; letter-spacing: -0.02em; }

  @media (max-width: 900px) {
    .body { grid-template-columns: 1fr; }
    .side { position: static; order: -1; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); padding-bottom: 8px; border-bottom: 1px solid var(--border); }
  }
</style>
